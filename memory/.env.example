# cognee + the sentinel's LLM configuration. Copy to `.env` and edit.
#
# This demo points cognee and the verdict model at a local Ollama server
# (qwen3:8b for reasoning, nomic-embed-text for embeddings). Point these at
# whatever LLM + embeddings you run.

# --- the LLM cognee uses, and that ask.py uses for the final verdict ---
# One model for both: there is nothing else to set up. For a hosted model, e.g.
#   LLM_PROVIDER="openai"  LLM_MODEL="gpt-4o-mini"  LLM_ENDPOINT="https://api.openai.com/v1"  LLM_API_KEY="sk-..."
# Small local models can struggle with the structured output cognee's graph
# extraction asks for (you will see "validation retry" in the service log);
# a hosted model makes seeding several times faster.
LLM_PROVIDER="ollama"
LLM_MODEL="qwen3:8b"
LLM_ENDPOINT="http://localhost:11434"
# For a local Ollama this is just a non-empty placeholder; set a real key for a
# hosted provider.
LLM_API_KEY="ollama"

# --- embeddings cognee uses to build its vector store ---
# Set as a group: if you set one EMBEDDING_* var, set them all, or cognee falls
# back to OpenAI for embeddings.
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_ENDPOINT="http://localhost:11434/api/embed"
EMBEDDING_DIMENSIONS="768"
# Recommended with Ollama embeddings, for accurate token counting / chunk sizing.
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"

# Disable cognee's session cache so a recall never echoes a prior session's
# answer back into the verdict. The three-role separation depends on this.
CACHING=false
# Fully local demo: don't phone home.
TELEMETRY_DISABLED=true

# --- where the yeet sysgraph service is (the yeet-service/ half) ---
# ask.py and collector.py read this; default is http://127.0.0.1:9490/reading
SENTINEL_READING_URL="http://127.0.0.1:9490/reading"
